# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public project URL + publishable key; never use service_role here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe (mode test pendant le développement)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# E-mails — Hostinger SMTP (recommandé pour la boîte professionnelle)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@rijrouteutrecht.nl
SMTP_PASSWORD=
# L'adresse doit généralement correspondre à SMTP_USER avec Hostinger
EMAIL_FROM="Stuurvast Rijschool <contact@rijrouteutrecht.nl>"
# Gmail dédié qui reçoit les demandes
EMAIL_TO=rijrouteutrecht@gmail.com

# Repli facultatif si SMTP_* n'est pas configuré
RESEND_API_KEY=re_...

# Shared rate limiting and durable Stripe notification processing
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enable only after actual business details and package conditions are verified
BUSINESS_DETAILS_VERIFIED=false
STRIPE_LIVE_ENABLED=false
PACKAGE_PRICES_VERIFIED=false
